@echo off
setlocal EnableDelayedExpansion
chcp 65001 >nul
title OTIMIZADOR TURBO GAMER v13.0 - Claudio Almeida.CAAS
color 02
mode con: cols=95 lines=50

set "LOG=%~dp0turbo_gamer_log.txt"

:: ================= ADMIN CHECK =================
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo.
    echo [!] ERRO: EXECUTE COMO ADMINISTRADOR!
    echo Pressione qualquer tecla para sair...
    pause >nul
    exit
)

:: ================= DIAGNOSTICO INICIAL (RAPIDO) =================
set "OS=Desconhecido"
for /f "tokens=2 delims==" %%a in ('wmic os get Caption /value 2^>nul') do (
    if not "%%a"=="" set "OS=%%a"
)

set "RAMGB=8"
for /f "skip=1 tokens=1" %%a in ('wmic computersystem get TotalPhysicalMemory 2^>nul') do (
    if not "%%a"=="" (
        set memBytes=%%a
        set memMB=!memBytes:~0,-6!
        if defined memMB (
            set /a RAMGB=!memMB! / 1024
        )
        goto :MENU
    )
)

:LOGMSG
echo [%date% %time%] %~1 >> "%LOG%"
goto :eof

:MENU
cls
echo.
echo    ██████╗  █████╗  █████╗  ███████╗   
echo   ██╔════╝ ██╔══██╗██╔══██╗ ██╔════╝
echo   ██║      ███████║███████║ ███████╗
echo   ██║      ██╔══██║██╔══██║ ╚════██║
echo   ╚██████╗ ██║  ██║██║  ██║ ███████║
echo    ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝ ╚══════╝
echo.
echo  ==================================================================
echo   Usuario  : %username%    ^|   Sistema: %OS%
echo   Maquina  : %computername% ^|   RAM      : %RAMGB% GB
echo  ==================================================================
echo.
echo   [1]  Diagnostico Detalhado Completo (SYSTEMINFO)
echo   [2]  Aplicar Otimizacao Gamer (Performance e CPU)
echo   [3]  Limpeza Deep Clean (Temp, Shaders e Logs)
echo   [4]  Ajustar Visual para Desempenho (Interface)
echo   [5]  Reiniciar Windows Explorer
echo   [6]  Ativar Modo Equilibrado (Reverter Alteracoes)
echo   [7]  Manutencao e Seguranca (SFC, CHKDSK, MSRT)
echo   [8]  Reduzir Latencia e Telemetria (Ping e Privacidade)
echo   [9]  Limpeza de Cache Windows Update
echo   [10] Gerenciar Programas de Inicializacao
echo   [11] Otimizacao de Disco (TRIM SSD / Desfragmentar HDD)
echo   [12] GPU Scheduling (HAGS) e Modo Tela Cheia Exclusivo
echo   [13] Otimizacao Avancada de Rede (Nagle / Jogos Online)
echo   [14] Gerenciador de Servicos em Segundo Plano
echo   [15] Ver Log de Alteracoes Realizadas
echo   [A]  Ajuda / Explicacao das Opcoes
echo   [0]  Sair
echo.
echo  ==================================================================
set /p opcao="Escolha uma opcao: "

if "%opcao%"=="1" goto DIAGNOSTICO
if "%opcao%"=="2" goto OTIMIZAR
if "%opcao%"=="3" goto LIMPEZA
if "%opcao%"=="4" goto VISUAL
if "%opcao%"=="5" goto EXPLORER
if "%opcao%"=="6" goto REVERTER
if "%opcao%"=="7" goto MANUTENCAO
if "%opcao%"=="8" goto REDE_TWEAKS
if "%opcao%"=="9" goto WINUPDATE
if "%opcao%"=="10" goto STARTUP_MGR
if "%opcao%"=="11" goto DISK_OPT
if "%opcao%"=="12" goto GPU_OPT
if "%opcao%"=="13" goto NET_ADV
if "%opcao%"=="14" goto SERVICE_MGR
if "%opcao%"=="15" goto VERLOG
if /i "%opcao%"=="A" goto AJUDA
if "%opcao%"=="0" exit
goto MENU

:: ================= AJUDA =================
:AJUDA
powershell -Command "Add-Type -AssemblyName PresentationFramework; [System.Windows.MessageBox]::Show('1. Diagnostico: Coleta dados tecnicos completos via SYSTEMINFO.`n`n2. Otimizacao Gamer: Plano de Desempenho Maximo, Game Mode, prioridade de CPU, limpa DNS.`n`n3. Deep Clean: Temp, cache de shaders, Prefetch, logs de eventos, lixeira.`n`n4. Visual: Abre configuracoes avancadas de desempenho da interface.`n`n5. Explorer: Reinicia a interface grafica para liberar RAM.`n`n6. Modo Equilibrado: Restaura configuracoes padrao.`n`n7. Manutencao: SFC, CHKDSK e MSRT.`n`n8. Latencia/Telemetria: Ajusta TCP/IP e desativa rastreamento.`n`n9. Cache Windows Update: Limpa downloads travados.`n`n10. Inicializacao: Lista e permite desativar programas que iniciam com o Windows.`n`n11. Disco: Executa TRIM em SSD ou desfragmentacao em HD mecanico.`n`n12. GPU: Ativa HAGS e Modo Tela Cheia Exclusivo para reduzir input lag.`n`n13. Rede Avancada: Desativa algoritmo de Nagle para reduzir latencia em jogos online.`n`n14. Servicos: Lista servicos nao essenciais para desativar manualmente.`n`n15. Log: Mostra historico de todas as alteracoes feitas pelo programa.', 'Ajuda - Otimizador Turbo Gamer PRO', 'OK', 'Information')" >nul 2>&1
goto MENU

:: ================= DIAGNOSTICO =================
:DIAGNOSTICO
cls
echo [!] Coletando informacoes detalhadas do sistema...
echo.
echo ------------------------------------------------------------------
systeminfo
echo ------------------------------------------------------------------
echo [+] Fim do relatorio.
call :LOGMSG "Diagnostico completo executado."
pause
goto MENU

:: ================= OTIMIZACAO GAMER =================
:OTIMIZAR
cls
echo ==================================================================
echo                   APLICANDO OTIMIZACAO GAMER
echo ==================================================================
echo.
echo [1/5] Deseja criar um Ponto de Restauracao do sistema antes? (S/N)
set /p confirmar="> "
if /i "%confirmar%"=="S" (
    echo [i] Criando ponto de restauracao...
    powershell -Command "Checkpoint-Computer -Description 'Turbo_Gamer_v13' -RestorePointType MODIFY_SETTINGS" >nul 2>&1
    echo [+] Ponto de restauracao processado.
) else (
    echo [i] Etapa ignorada pelo usuario.
)

echo.
echo [2/5] Configurando Plano de Energia de Desempenho Maximo...
powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 >nul 2>&1
for /f "tokens=4" %%a in ('powercfg -l ^| findstr /i "Desempenho Máximo Maximum Performance"') do (
    powercfg /setactive %%a >nul 2>&1
)
echo [+] Plano de energia ajustado.

echo.
echo [3/5] Otimizando prioridade de CPU e Game Mode...
reg add "HKCU\Software\Microsoft\GameBar" /v "AllowAutoGameMode" /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\System\CurrentControlSet\Control\PriorityControl" /v "Win32PrioritySeparation" /t REG_DWORD /d 38 /f >nul 2>&1
echo [+] Prioridade de CPU e Game Mode ativados.

echo.
echo [4/5] Limpando cache DNS...
ipconfig /flushdns >nul 2>&1
echo [+] Cache DNS limpo.

echo.
echo [5/5] Finalizando...
timeout /t 1 /nobreak >nul

echo.
echo ==================================================================
echo [+] OTIMIZACAO GAMER APLICADA COM SUCESSO!
echo ==================================================================
call :LOGMSG "Otimizacao Gamer aplicada (energia, GameBar, prioridade CPU, DNS)."
pause
goto MENU

:: ================= LIMPEZA =================
:LIMPEZA
cls
echo [!] Iniciando limpeza profunda...
del /f /s /q "%temp%\*.*" >nul 2>&1
for /d %%i in ("%temp%\*") do rd /s /q "%%i" >nul 2>&1
del /f /s /q "C:\Windows\Temp\*.*" >nul 2>&1
for /d %%i in ("C:\Windows\Temp\*") do rd /s /q "%%i" >nul 2>&1
del /f /s /q "%LocalAppData%\Microsoft\DirectX Shader Cache\*.*" >nul 2>&1
del /f /s /q "C:\Windows\Prefetch\*.*" >nul 2>&1
wevtutil cl Setup >nul 2>&1
wevtutil cl System >nul 2>&1
wevtutil cl Application >nul 2>&1
powershell -Command "Clear-RecycleBin -Force -ErrorAction SilentlyContinue" >nul 2>&1
echo [+] Limpeza concluida!
call :LOGMSG "Deep Clean executado (temp, shaders, prefetch, logs, lixeira)."
pause
goto MENU

:: ================= MANUTENCAO =================
:MANUTENCAO
cls
echo [1] SFC Scannow (Repara arquivos do sistema)
echo [2] CHKDSK (Corrige erros de disco)
echo [3] MSRT Microsoft (Remocao de Software Mal-Intencionado)
echo [0] Voltar ao Menu
set /p manut="Escolha uma opcao: "
if "%manut%"=="1" (
    sfc /scannow
    call :LOGMSG "SFC Scannow executado."
    pause
    goto MANUTENCAO
)
if "%manut%"=="2" (
    echo S | chkdsk C: /f /r
    call :LOGMSG "CHKDSK agendado/executado."
    pause
    goto MANUTENCAO
)
if "%manut%"=="3" (
    start mrt.exe
    goto MANUTENCAO
)
if "%manut%"=="0" goto MENU
goto MANUTENCAO

:: ================= REDE / TELEMETRIA =================
:REDE_TWEAKS
cls
echo [!] Otimizando latencia e privacidade...
netsh int tcp set global autotuninglevel=normal >nul 2>&1
netsh int tcp set global chimney=enabled >nul 2>&1
sc stop DiagTrack >nul 2>&1
sc config DiagTrack start= disabled >nul 2>&1
sc stop dmwappushservice >nul 2>&1
sc config dmwappushservice start= disabled >nul 2>&1
echo [+] Sucesso!
call :LOGMSG "Latencia/telemetria ajustadas (TCP tuning, DiagTrack desativado)."
pause
goto MENU

:: ================= WINDOWS UPDATE =================
:WINUPDATE
cls
echo [!] Parando servicos do Windows Update...
net stop wuauserv >nul 2>&1
net stop bits >nul 2>&1
echo [!] Removendo arquivos temporarios de atualizacao...
rd /s /q C:\Windows\SoftwareDistribution\Download >nul 2>&1
md C:\Windows\SoftwareDistribution\Download >nul 2>&1
echo [!] Reiniciando servicos...
net start wuauserv >nul 2>&1
net start bits >nul 2>&1
echo [+] Cache do Windows Update limpo!
call :LOGMSG "Cache do Windows Update limpo."
pause
goto MENU

:: ================= NOVO: GERENCIADOR DE INICIALIZACAO =================
:STARTUP_MGR
cls
echo ==================================================================
echo            PROGRAMAS QUE INICIAM COM O WINDOWS
echo ==================================================================
echo.
wmic startup get Caption,Command 2>nul
echo.
echo Para desativar um programa, use o Gerenciador de Tarefas
echo (Ctrl+Shift+Esc ^> aba Inicializar) e clique em "Desativar".
echo Deseja abrir o Gerenciador de Tarefas agora? (S/N)
set /p abrirgt="> "
if /i "%abrirgt%"=="S" start taskmgr.exe
call :LOGMSG "Consulta de programas de inicializacao realizada."
pause
goto MENU

:: ================= NOVO: OTIMIZACAO DE DISCO =================
:DISK_OPT
cls
echo ==================================================================
echo                  OTIMIZACAO DE DISCO (TRIM / DESFRAG)
echo ==================================================================
echo.
echo Detectando unidades e tipo de disco...
echo.
powershell -Command "Get-PhysicalDisk | Select-Object DeviceId, FriendlyName, MediaType, @{Name='SizeGB';Expression={[math]::Round($_.Size/1GB,1)}} | Format-Table -AutoSize"
echo.
echo [!] Executando otimizacao automatica (TRIM em SSD / Desfrag em HDD) na unidade C:...
defrag C: /O >nul 2>&1
echo [+] Otimizacao de disco concluida.
call :LOGMSG "Otimizacao de disco (TRIM/Desfrag) executada em C:."
pause
goto MENU

:: ================= NOVO: GPU SCHEDULING E TELA CHEIA EXCLUSIVA =================
:GPU_OPT
cls
echo ==================================================================
echo        GPU SCHEDULING (HAGS) E MODO TELA CHEIA EXCLUSIVA
echo ==================================================================
echo.
echo [1] Ativar HAGS (Hardware Accelerated GPU Scheduling)
echo [2] Desativar HAGS
echo [3] Desativar Otimizacoes de Tela Cheia (permite Exclusivo Fullscreen)
echo [4] Reativar Otimizacoes de Tela Cheia (padrao Windows)
echo [0] Voltar
set /p gpuop="Escolha uma opcao: "
if "%gpuop%"=="1" (
    reg add "HKLM\SYSTEM\CurrentControlSet\Control\GraphicsDrivers" /v "HwSchMode" /t REG_DWORD /d 2 /f >nul 2>&1
    echo [+] HAGS ativado. Reinicie o computador para aplicar.
    call :LOGMSG "HAGS ativado."
)
if "%gpuop%"=="2" (
    reg add "HKLM\SYSTEM\CurrentControlSet\Control\GraphicsDrivers" /v "HwSchMode" /t REG_DWORD /d 1 /f >nul 2>&1
    echo [+] HAGS desativado. Reinicie o computador para aplicar.
    call :LOGMSG "HAGS desativado."
)
if "%gpuop%"=="3" (
    reg add "HKCU\System\GameConfigStore" /v "GameDVR_FSEBehaviorMode" /t REG_DWORD /d 2 /f >nul 2>&1
    reg add "HKCU\System\GameConfigStore" /v "GameDVR_HonorUserFSEBehaviorMode" /t REG_DWORD /d 1 /f >nul 2>&1
    echo [+] Otimizacoes de Tela Cheia desativadas (Fullscreen Exclusivo liberado).
    call :LOGMSG "Otimizacoes de tela cheia desativadas."
)
if "%gpuop%"=="4" (
    reg delete "HKCU\System\GameConfigStore" /v "GameDVR_FSEBehaviorMode" /f >nul 2>&1
    reg delete "HKCU\System\GameConfigStore" /v "GameDVR_HonorUserFSEBehaviorMode" /f >nul 2>&1
    echo [+] Padrao do Windows restaurado.
    call :LOGMSG "Otimizacoes de tela cheia restauradas ao padrao."
)
pause
goto MENU

:: ================= NOVO: REDE AVANCADA (JOGOS ONLINE) =================
:NET_ADV
cls
echo ==================================================================
echo         OTIMIZACAO AVANCADA DE REDE PARA JOGOS ONLINE
echo ==================================================================
echo.
echo [!] Desativando algoritmo de Nagle (reduz latencia/ping em jogos online)...
for /f "tokens=1" %%i in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces" ^| findstr /i "HKEY"') do (
    reg add "%%i" /v "TcpAckFrequency" /t REG_DWORD /d 1 /f >nul 2>&1
    reg add "%%i" /v "TCPNoDelay" /t REG_DWORD /d 1 /f >nul 2>&1
)
echo [+] Nagle desativado em todas as interfaces de rede.
echo.
echo [!] Ajustando prioridade de rede para jogos (QoS)...
netsh int tcp set global ecncapability=disabled >nul 2>&1
echo [+] QoS ajustado.
echo.
echo [AVISO] Estas alteracoes podem aumentar levemente o uso de rede
echo em troca de menor latencia. Reinicie o PC para aplicar totalmente.
call :LOGMSG "Otimizacao avancada de rede aplicada (Nagle desativado, QoS ajustado)."
pause
goto MENU

:: ================= NOVO: GERENCIADOR DE SERVICOS =================
:SERVICE_MGR
cls
echo ==================================================================
echo         SERVICOS EM SEGUNDO PLANO (NAO ESSENCIAIS)
echo ==================================================================
echo.
echo Os servicos abaixo geralmente podem ser desativados com seguranca
echo em PCs gamer que nao usam as funcoes correspondentes:
echo.
echo  - Fax
echo  - Windows Search (impacta buscas do menu Iniciar se desativado)
echo  - Print Spooler (se nao usar impressora)
echo  - Bluetooth Support Service (se nao usar Bluetooth)
echo  - Xbox Game Monitoring / Xbox Live services (se nao usar Xbox App)
echo.
echo [1] Desativar Fax
echo [2] Desativar Print Spooler
echo [3] Desativar Servicos Xbox (Live/Monitoring)
echo [0] Voltar (nao alterar nada)
set /p svcop="Escolha uma opcao: "
if "%svcop%"=="1" (
    sc config Fax start= disabled >nul 2>&1
    sc stop Fax >nul 2>&1
    echo [+] Fax desativado.
    call :LOGMSG "Servico Fax desativado."
)
if "%svcop%"=="2" (
    sc config Spooler start= disabled >nul 2>&1
    sc stop Spooler >nul 2>&1
    echo [+] Print Spooler desativado. (Reative se for usar impressora)
    call :LOGMSG "Servico Print Spooler desativado."
)
if "%svcop%"=="3" (
    sc config XblAuthManager start= disabled >nul 2>&1
    sc config XblGameSave start= disabled >nul 2>&1
    sc config XboxNetApiSvc start= disabled >nul 2>&1
    sc config XboxGipSvc start= disabled >nul 2>&1
    echo [+] Servicos Xbox desativados.
    call :LOGMSG "Servicos Xbox desativados."
)
pause
goto MENU

:: ================= NOVO: VISUALIZAR LOG =================
:VERLOG
cls
echo ==================================================================
echo                  HISTORICO DE ALTERACOES
echo ==================================================================
echo.
if exist "%LOG%" (
    type "%LOG%"
) else (
    echo Nenhuma alteracao registrada ainda.
)
echo.
pause
goto MENU

:VISUAL
start SystemPropertiesPerformance.exe
goto MENU

:EXPLORER
taskkill /f /im explorer.exe >nul 2>&1
timeout /t 2 /nobreak >nul
start explorer.exe
call :LOGMSG "Windows Explorer reiniciado."
goto MENU

:REVERTER
cls
powercfg /setactive SCHEME_BALANCED >nul
reg add "HKLM\System\CurrentControlSet\Control\PriorityControl" /v "Win32PrioritySeparation" /t REG_DWORD /d 2 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\GraphicsDrivers" /v "HwSchMode" /t REG_DWORD /d 1 /f >nul 2>&1
reg delete "HKCU\System\GameConfigStore" /v "GameDVR_FSEBehaviorMode" /f >nul 2>&1
reg delete "HKCU\System\GameConfigStore" /v "GameDVR_HonorUserFSEBehaviorMode" /f >nul 2>&1
echo [+] Windows restaurado para o Modo Equilibrado (energia, CPU e GPU).
call :LOGMSG "Reversao completa para Modo Equilibrado executada."
pause
goto MENU
